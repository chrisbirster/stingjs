package __PACKAGE__

import android.app.Activity
import android.content.Context
import android.os.Build
import android.os.SystemClock
import android.text.Editable
import android.text.TextWatcher
import android.view.View
import android.view.ViewGroup
import android.view.WindowManager
import android.widget.TextView
import androidx.test.core.app.ActivityScenario
import androidx.test.ext.junit.runners.AndroidJUnit4
import androidx.test.platform.app.InstrumentationRegistry
import java.io.File
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale
import java.util.TimeZone
import java.util.concurrent.CountDownLatch
import java.util.concurrent.TimeUnit
import java.util.concurrent.atomic.AtomicInteger
import java.util.concurrent.atomic.AtomicLong
import org.json.JSONArray
import org.json.JSONObject
import org.junit.Assert.assertEquals
import org.junit.Assert.assertNotNull
import org.junit.Assert.assertTrue
import org.junit.Test
import org.junit.runner.RunWith

@RunWith(AndroidJUnit4::class)
class PhysicalEvidenceInstrumentedTest {
    @Test
    fun captureSparseAndDenseHermesBaseline() {
        val instrumentation = InstrumentationRegistry.getInstrumentation()
        val arguments = InstrumentationRegistry.getArguments()
        val benchmarkCommit = arguments.getString("benchmarkCommit")
            ?: error("-e benchmarkCommit <40-char-sha> is required")
        require(benchmarkCommit.matches(Regex("^[0-9a-f]{40}$"))) {
            "benchmarkCommit must be a full 40-character Git SHA"
        }

        val targetContext = instrumentation.targetContext
        val sparseSamples = DoubleArray(SAMPLE_COUNT)
        val denseSamples = DoubleArray(SAMPLE_COUNT)

        ActivityScenario.launch(MainActivity::class.java).use { scenario ->
            waitForText(scenario, "Mount 10k rows")
            clickText(scenario, "Mount 10k rows")
            waitForTextPrefix(scenario, "Row 4281:")

            repeat(WARMUP_COUNT) {
                measureSparse(scenario)
            }
            repeat(SAMPLE_COUNT) { index ->
                sparseSamples[index] = measureSparse(scenario)
            }

            repeat(WARMUP_COUNT) {
                measureDense(scenario)
            }
            repeat(SAMPLE_COUNT) { index ->
                denseSamples[index] = measureDense(scenario)
            }
        }

        val document = JSONObject()
            .put("captureDocumentVersion", 1)
            .put("role", "decision-evidence")
            .put("metadata", metadata(targetContext, benchmarkCommit))
            .put(
                "captures",
                JSONArray()
                    .put(measurement("sparse-10k-row-update", sparseSamples))
                    .put(measurement("dense-10k-100-row-update", denseSamples)),
            )

        val outputDirectory = File(
            targetContext.getExternalFilesDir(null),
            "sting-benchmarks",
        )
        check(outputDirectory.mkdirs() || outputDirectory.isDirectory) {
            "Unable to create ${outputDirectory.absolutePath}"
        }
        val output = File(outputDirectory, "react-native-hermes-android.json")
        output.writeText(document.toString(2) + "\n")
        println("STING_PHYSICAL_EVIDENCE=${output.absolutePath}")
    }

    private fun measureSparse(scenario: ActivityScenario<MainActivity>): Double {
        val finished = AtomicLong(0)
        val latch = CountDownLatch(1)
        var watcher: TextWatcher? = null
        var target: TextView? = null
        var started = 0L

        scenario.onActivity { activity ->
            val root = activity.window.decorView
            target = findTextView(root) { it.startsWith("Row 4281:") }
            val button = findTextView(root) { it == "Update row 4,281" }
            assertNotNull("sparse target native TextView", target)
            assertNotNull("sparse update control", button)

            watcher = afterTextChangedWatcher {
                if (finished.compareAndSet(0, SystemClock.elapsedRealtimeNanos())) {
                    latch.countDown()
                }
            }
            target!!.addTextChangedListener(watcher)
            started = SystemClock.elapsedRealtimeNanos()
            clickableAncestor(button!!).performClick()
        }

        assertTrue("sparse native mutation timed out", latch.await(TIMEOUT_SECONDS, TimeUnit.SECONDS))
        scenario.onActivity {
            target?.removeTextChangedListener(watcher)
        }
        return (finished.get() - started) / 1_000_000.0
    }

    private fun measureDense(scenario: ActivityScenario<MainActivity>): Double {
        val finished = AtomicLong(0)
        val latch = CountDownLatch(1)
        val remaining = AtomicInteger(DENSE_TARGETS.size)
        val watchers = mutableListOf<Pair<TextView, TextWatcher>>()
        var started = 0L

        scenario.onActivity { activity ->
            val root = activity.window.decorView
            val rows = collectRowViews(root)
            val button = findTextView(root) { it == "Update 100 rows" }
            assertNotNull("dense update control", button)
            assertEquals("all dense target native rows must be mounted", DENSE_TARGETS.size, rows.size)

            for ((_, view) in rows) {
                val watcher = afterTextChangedWatcher {
                    if (remaining.decrementAndGet() == 0) {
                        finished.set(SystemClock.elapsedRealtimeNanos())
                        latch.countDown()
                    }
                }
                watchers += view to watcher
                view.addTextChangedListener(watcher)
            }

            started = SystemClock.elapsedRealtimeNanos()
            clickableAncestor(button!!).performClick()
        }

        assertTrue("dense native mutations timed out", latch.await(TIMEOUT_SECONDS, TimeUnit.SECONDS))
        scenario.onActivity {
            for ((view, watcher) in watchers) view.removeTextChangedListener(watcher)
        }
        return (finished.get() - started) / 1_000_000.0
    }

    private fun waitForText(scenario: ActivityScenario<MainActivity>, text: String) {
        waitFor(scenario) { root -> findTextView(root) { it == text } != null }
    }

    private fun waitForTextPrefix(scenario: ActivityScenario<MainActivity>, prefix: String) {
        waitFor(scenario) { root -> findTextView(root) { it.startsWith(prefix) } != null }
    }

    private fun waitFor(
        scenario: ActivityScenario<MainActivity>,
        condition: (View) -> Boolean,
    ) {
        val deadline = SystemClock.elapsedRealtime() + TIMEOUT_SECONDS * 1_000L
        while (SystemClock.elapsedRealtime() < deadline) {
            var matched = false
            scenario.onActivity { matched = condition(it.window.decorView) }
            if (matched) return
            InstrumentationRegistry.getInstrumentation().waitForIdleSync()
            Thread.sleep(25)
        }
        error("Timed out waiting for React Native benchmark UI")
    }

    private fun clickText(scenario: ActivityScenario<MainActivity>, text: String) {
        scenario.onActivity { activity ->
            val view = findTextView(activity.window.decorView) { it == text }
            assertNotNull("control text $text", view)
            clickableAncestor(view!!).performClick()
        }
    }

    private fun clickableAncestor(view: View): View {
        var current: View? = view
        while (current != null) {
            if (current.isClickable) return current
            current = current.parent as? View
        }
        error("No clickable native ancestor for ${if (view is TextView) view.text else view.javaClass.name}")
    }

    private fun findTextView(root: View, predicate: (String) -> Boolean): TextView? {
        if (root is TextView && predicate(root.text?.toString().orEmpty())) return root
        if (root !is ViewGroup) return null
        for (index in 0 until root.childCount) {
            val match = findTextView(root.getChildAt(index), predicate)
            if (match != null) return match
        }
        return null
    }

    private fun collectRowViews(root: View): Map<Int, TextView> {
        val rows = linkedMapOf<Int, TextView>()
        fun visit(view: View) {
            if (view is TextView) {
                val text = view.text?.toString().orEmpty()
                val match = ROW_PATTERN.matchEntire(text)
                if (match != null) {
                    val id = match.groupValues[1].toInt()
                    if (id in DENSE_TARGETS) rows[id] = view
                }
            }
            if (view is ViewGroup) {
                for (index in 0 until view.childCount) visit(view.getChildAt(index))
            }
        }
        visit(root)
        return rows
    }

    private fun afterTextChangedWatcher(callback: () -> Unit): TextWatcher = object : TextWatcher {
        override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) = Unit
        override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) = Unit
        override fun afterTextChanged(s: Editable?) = callback()
    }

    private fun measurement(scenario: String, samples: DoubleArray): JSONObject =
        JSONObject()
            .put("scenario", scenario)
            .put("metric", "native-event-to-visible-update-latency")
            .put("unit", "ms")
            .put("direction", "lower-is-better")
            .put("samples", JSONArray().apply { samples.forEach { put(it) } })

    @Suppress("DEPRECATION")
    private fun metadata(context: Context, benchmarkCommit: String): JSONObject {
        val windowManager = context.getSystemService(Context.WINDOW_SERVICE) as WindowManager
        val recordedAt = SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", Locale.US).apply {
            timeZone = TimeZone.getTimeZone("UTC")
        }.format(Date())
        return JSONObject()
            .put("benchmarkCommit", benchmarkCommit)
            .put("recordedAt", recordedAt)
            .put("platform", "android")
            .put("environment", "physical-device")
            .put("device", "${Build.MANUFACTURER} ${Build.MODEL}".trim())
            .put("deviceArchitecture", Build.SUPPORTED_ABIS.firstOrNull() ?: "unknown")
            .put("osVersion", "Android ${Build.VERSION.RELEASE} (API ${Build.VERSION.SDK_INT})")
            .put("build", "release")
            .put("system", "react-native")
            .put("engine", "hermes")
            .put("engineVersion", "250829098.0.16")
            .put("frameworkVersion", "React Native 0.87.0")
            .put("displayRefreshHz", windowManager.defaultDisplay.refreshRate.toDouble())
    }

    private companion object {
        const val WARMUP_COUNT = 5
        const val SAMPLE_COUNT = 30
        const val TIMEOUT_SECONDS = 60L
        val DENSE_TARGETS = Array.from
        val ROW_PATTERN = Regex("^Row (\\d+): \\d+$")
    }
}
