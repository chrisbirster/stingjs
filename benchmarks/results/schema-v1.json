{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stingjs.dev/schemas/runtime-engine-result-v1.json",
  "title": "StingJS runtime engine physical-device result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "measurement"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmarkCommit",
        "recordedAt",
        "platform",
        "device",
        "osVersion",
        "build",
        "system",
        "engine",
        "engineVersion",
        "frameworkVersion",
        "displayRefreshHz",
        "sampleCount"
      ],
      "properties": {
        "benchmarkCommit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "platform": {
          "enum": ["ios", "android"]
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "deviceArchitecture": {
          "type": "string",
          "minLength": 1
        },
        "osVersion": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "const": "release"
        },
        "system": {
          "enum": ["sting", "react-native"]
        },
        "engine": {
          "enum": ["quickjs", "quickjs-ng", "hermes"]
        },
        "engineVersion": {
          "type": "string",
          "minLength": 1
        },
        "frameworkVersion": {
          "type": "string",
          "minLength": 1
        },
        "displayRefreshHz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 1
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "metric", "unit", "direction", "samples"],
      "properties": {
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "enum": ["ms", "bytes", "count", "fps", "percent"]
        },
        "direction": {
          "enum": ["lower-is-better", "higher-is-better", "neutral"]
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
