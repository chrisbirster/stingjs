{
  "name": "create-sting",
  "version": "1.0.0-bootstrap.0",
  "description": "Create standalone StingJS applications for SolidJS 2.",
  "type": "module",
  "bin": {
    "create-sting": "./dist/cli.js"
  },
  "files": [
