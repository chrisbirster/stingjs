{
  "name": "stingjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "packages/core",
    "packages/solid",
    "packages/native",
    "packages/modules/*",
    "examples/*",
    "benchmarks/sting-benchmark",
    "benchmarks/solid2-conformance"
  ],
  "scripts": {
    "benchmark:import-evidence": "node benchmarks/results/candidate-evidence-cli.mjs",
    "benchmark:ios-jsc-control": "bash scripts/collect-ios-jsc-control.sh",
    "benchmark:results": "node benchmarks/results/tool.mjs",
    "benchmark:transport": "bash benchmarks/transport/run.sh",
    "build": "npm run build --workspaces --if-present",
    "release:check:v0.1": "node scripts/check-v0.1-release.mjs",
    "test": "npm run test --workspaces --if-present && node --test benchmarks/results/tool.test.mjs benchmarks/results/capture.test.mjs benchmarks/results/candidate-capture.test.mjs benchmarks/results/candidate-evidence-cli.test.mjs benchmarks/transport/summarize.test.mjs",
    "test:ios-runtime": "bash scripts/test-ios-runtime.sh",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
