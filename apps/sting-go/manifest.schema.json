{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stingjs.dev/schemas/sting-go-manifest-v1.json",
  "title": "Sting Go development manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runtimeVersion", "engine", "project", "bundle", "development", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runtimeVersion": { "type": "string", "minLength": 1 },
    "engine": { "const": "quickjs" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contentType"],
      "properties": {
        "path": { "const": "/bundle" },
        "contentType": { "const": "application/javascript" }
      }
    },
    "development": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reload", "health"],
      "properties": {
        "reload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "transport", "contentType"],
          "properties": {
            "path": { "const": "/events" },
            "transport": { "const": "sse" },
            "contentType": { "const": "text/event-stream" }
          }
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "contentType"],
          "properties": {
            "path": { "const": "/health" },
            "contentType": { "const": "application/json" }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
