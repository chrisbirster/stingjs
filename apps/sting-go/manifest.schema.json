{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stingjs.dev/schemas/sting-go-manifest-v1.json",
  "title": "Sting Go development manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runtimeVersion", "engine", "project", "bundle", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runtimeVersion": { "type": "string", "minLength": 1 },
    "engine": { "const": "quickjs" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contentType"],
      "properties": {
        "path": { "const": "/bundle" },
        "contentType": { "const": "application/javascript" }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
